# Server-side Gemini API key (configured in Cloud Run Secret Manager / env vars)
GEMINI_API_KEY=

# HMAC signing secret for expiring Windows agent session tokens (set a strong random string in Cloud Run)
AGENT_TOKEN_SECRET=

# Agent token TTL in seconds (default 86400 = 24 hours)
AGENT_TOKEN_TTL_SECONDS=86400

# Provisioned Firestore named database ID
FIREBASE_DATABASE_ID=ai-studio-android-diyaai-96dc77ad-8481-4285-b7fd-2dc01f2813b9

# Comma-separated allowed web origins for CORS (e.g. https://your-diya-app.vercel.app)
ALLOWED_ORIGINS=

# Cloud Run listening port (default 8080)
PORT=8080
