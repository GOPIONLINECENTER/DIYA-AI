# Encrypted Cloud Run relay WSS endpoint (wss://...)
RELAY_WSS_URL=

# Firebase user ID token obtained via authenticated desktop sign-in flow
FIREBASE_ID_TOKEN=

# Unique Windows agent device ID & display name
PC_DEVICE_ID=win_workstation_01
PC_DEVICE_NAME=Windows Workstation

# Strictly confined workspace folder for scoped document searches
SAFE_WORKSPACE_DIR=
