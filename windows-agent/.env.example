# Encrypted Cloud Run relay HTTPS endpoint (https://...)
# WSS endpoint (wss://...) is derived automatically from RELAY_HTTPS_URL
RELAY_HTTPS_URL=

# Optional explicit WSS override (wss://...)
RELAY_WSS_URL=

# Deployed DIYA AI web console URL (https://...) used by `npm run pair`
WEB_CONSOLE_URL=

# Unique Windows agent device ID & human-readable display name
PC_DEVICE_ID=win_workstation_01
PC_DEVICE_NAME=Windows Workstation

# Strictly confined workspace folder for scoped document searches & archiving
SAFE_WORKSPACE_DIR=

# Optional headless CLI pairing (only needed if not using `npm run pair`)
PAIRING_CODE=
FIREBASE_ID_TOKEN=
